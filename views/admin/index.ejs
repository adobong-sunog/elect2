<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">All Activities</h1>
    <p class="text-muted mb-0">Review every submission across all leaders.</p>
  </div>
</div>

<section class="card shadow-sm border-0">
  <div class="card-body p-0">
    <% if (!events.length) { %>
      <div class="p-4 text-center text-muted">No activities have been submitted yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Date</th>
              <th scope="col">Leader(s)</th>
              <th scope="col">Submitted By</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach((event) => { %>
              <tr>
                <td>
                  <a href="/events/<%= event.id %>" class="text-decoration-none"><%= event.title %></a>
                </td>
                <td><%= new Date(event.activity_date).toLocaleDateString() %></td>
                <td><%= event.leader_names %></td>
                <td>
                  <% if (event.owner) { %>
                    <div><strong><%= event.owner.name %></strong></div>
                    <div class="text-muted small"><%= event.owner.email %></div>
                  <% } else { %>
                    <span class="text-muted">Unassigned</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group" role="group">
                    <a href="/events/<%= event.id %>" class="btn btn-sm btn-outline-primary">View</a>
                    <a href="/events/<%= event.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form method="post" action="/events/<%= event.id %>?_method=DELETE" onsubmit="return confirm('Delete this activity? This cannot be undone.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
