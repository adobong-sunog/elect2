<% const fieldError = (name) => errors.find((err) => err.param === name); %>
<body class="auth-bg">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <h1 class="h3 mb-3">Sign In</h1>
      <p class="text-muted">Access your Narra Nueva ATF activities.</p>

      <% if (errors.length) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach((err) => { %>
              <li><%= err.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/auth/login" novalidate>
        <div class="mb-3">
          <label class="form-label" for="email">Email or username</label>
          <input
            type="text"
            class="form-control <%= fieldError('email') ? 'is-invalid' : '' %>"
            id="email"
            name="email"
            value="<%= form.email %>"
            autocomplete="username"
            required
            autofocus
          >
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <input
            type="password"
            class="form-control <%= fieldError('password') ? 'is-invalid' : '' %>"
            id="password"
            name="password"
            autocomplete="current-password"
            required
          >
        </div>
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">Sign In</button>
        </div>
      </form>

      <p class="mt-3 mb-0 text-muted">Need an account? <a href="/auth/register">Create one</a>.</p>
    </div>
  </div>
</body>