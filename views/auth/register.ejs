<% const fieldError = (name) => errors.find((err) => err.param === name); %>
<body class="auth-bg">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <h1 class="h3 mb-3">Create Account</h1>
      <p class="text-muted">Register your account.</p>

      <% if (errors.length) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach((err) => { %>
              <li><%= err.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/auth/register" novalidate>
        <div class="mb-3">
          <label class="form-label" for="name">Full name</label>
          <input
            type="text"
            class="form-control <%= fieldError('name') ? 'is-invalid' : '' %>"
            id="name"
            name="name"
            value="<%= form.name %>"
            autocomplete="name"
            required
            autofocus
          >
        </div>
        <div class="mb-3">
          <label class="form-label" for="email">Email address</label>
          <input
            type="email"
            class="form-control <%= fieldError('email') ? 'is-invalid' : '' %>"
            id="email"
            name="email"
            value="<%= form.email %>"
            autocomplete="email"
            required
          >
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <input
            type="password"
            class="form-control <%= fieldError('password') ? 'is-invalid' : '' %>"
            id="password"
            name="password"
            autocomplete="new-password"
            required
            minlength="8"
          >
          <div class="form-text">Use at least 8 characters.</div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="confirm_password">Confirm password</label>
          <input
            type="password"
            class="form-control <%= fieldError('confirm_password') ? 'is-invalid' : '' %>"
            id="confirm_password"
            name="confirm_password"
            autocomplete="new-password"
            required
          >
        </div>
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">Create Account</button>
        </div>
      </form>

      <p class="mt-3 mb-0 text-muted">Already have an account? <a href="/auth/login">Sign in</a>.</p>
    </div>
  </div>
</body>