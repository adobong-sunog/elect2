<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
  <h1 class="h3 mb-1"><%= title %></h1>
  <p class="text-muted mb-0">Track and manage your events.</p>
  </div>
</div>

<section class="card shadow-sm border-0">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <strong>Recent Activities</strong>
    <% if (isAdmin) { %>
      <span class="badge text-bg-primary">Admin</span>
    <% } %>
  </div>
  <div class="card-body p-0">
    <% if (!events.length) { %>
      <div class="p-4 text-center text-muted">No activities found yet. Create your first activity to get started.</div>
    <% } else { %>
      <div class="event-scroll">
        <% events.forEach((event) => { %>
          <article class="border-bottom p-4">
            <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center mb-2">
              <h3 class="h5 mb-0"><%= event.title %></h3>
              <span class="badge text-bg-light"><%= new Date(event.activity_date).toLocaleDateString() %></span>
            </div>
            <p class="mb-1 text-muted small">
              <strong>Leader(s):</strong> <%= event.leader_names %> ·
              <strong>Venue:</strong> <%= event.venue %>
              <% if (isAdmin && event.owner) { %>
                · <strong>Submitted by:</strong> <%= event.owner.name %> (<%= event.owner.email %>)
              <% } %>
            </p>
            <p class="mb-3"><%= event.impact_summary %></p>
            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-sm btn-outline-primary" href="/events/<%= event.id %>">View</a>
              <a class="btn btn-sm btn-outline-secondary" href="/events/<%= event.id %>/edit">Edit</a>
              <form method="post" action="/events/<%= event.id %>?_method=DELETE" onsubmit="return confirm('Delete this activity? This cannot be undone.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
