<div class="text-center py-5">
  <h1 class="display-5 fw-bold">Something went wrong</h1>
  <p class="lead">An unexpected error occurred. Please try again or contact the administrator if the issue persists.</p>
  <% if (error) { %>
    <pre class="text-start bg-light border rounded p-3 overflow-auto"><%= error.stack %></pre>
  <% } %>
  <a href="/" class="btn btn-primary">Return Home</a>
</div>
